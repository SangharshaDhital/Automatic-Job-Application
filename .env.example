# GEMINI_API_KEY: Required for hybrid Gemini AI API calls on the server.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# OLLAMA_HOST: Local Ollama daemon endpoint for 100% private local LLM inference.
OLLAMA_HOST="http://127.0.0.1:11434"

# OLLAMA_MODEL: Default local model to invoke via Ollama (e.g., llama3.2, qwen2.5-coder, mistral).
OLLAMA_MODEL="llama3.2"
